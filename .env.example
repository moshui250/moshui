# CodeAgent 环境变量模板
# 复制为 .env 仅作为本地记录；Spring Boot 不会自动读取 .env 文件。
# 请在 IDE 运行配置、PowerShell/$env:、bash export 或 Docker Compose 中注入。

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codeagent
DB_USERNAME=root
DB_PASSWORD=change-me

# ---------- JWT ----------
# 必填；HS256 要求至少 32 字节。用随机值，不要提交真实密钥。
# 生成示例：openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ---------- Embedding（SiliconFlow） ----------
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_API_KEY=replace-with-siliconflow-key
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ---------- Zilliz / Milvus ----------
# 未配置时应用仍可启动，RAG 相关能力降级。
ZILLIZ_URI=https://your-zilliz-endpoint
ZILLIZ_TOKEN=replace-with-zilliz-token
ZILLIZ_DATABASE=default

# ---------- DeepSeek ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-deepseek-key
# deepseek-flash 的流式响应可能只返回 reasoning_content，建议使用 deepseek-chat。
DEEPSEEK_MODEL=deepseek-chat

# ---------- 图片录题（DashScope 视觉模型） ----------
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=replace-with-dashscope-key
DASHSCOPE_VISION_MODEL=qwen-vl-max
DASHSCOPE_FALLBACK_VISION_MODEL=qwen3-vl-plus

# ---------- 图片存储 ----------
# 必须是持久、可写目录；Docker 部署时挂载为 volume。
FILE_UPLOAD_DIR=./data/upload
# 留空时返回 /uploads/...；前后端不同域时填后端公网地址。
FILE_PUBLIC_BASE_URL=

# ---------- go-judge ----------
GOJUDGE_BASE_URL=http://127.0.0.1:5050
# 以下路径要与实际判题镜像内的 JDK / 工具链一致。
GOJUDGE_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
GOJUDGE_PATH=/usr/lib/jvm/java-17-openjdk-amd64/bin:/usr/local/bin:/usr/bin:/bin
GOJUDGE_LD_LIBRARY_PATH=/usr/lib/jvm/java-17-openjdk-amd64/lib:/usr/lib/jvm/java-17-openjdk-amd64/lib/server
GOJUDGE_JAVA_XMX=512m

# ---------- 可选：RAG 初始化 ----------
# 首次建集合时需要；生产环境保持 false，避免启动时重复写向量。
RAG_ZILLIZ_INITIALIZE_SCHEMA=false
